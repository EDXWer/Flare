  "settings_ai_config_context_window_hint": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Leave blank to use the known model limit. Unknown models use an estimated budget of 8192 tokens. Enter at least 1024 tokens to override."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "留空使用已知模型的上限；未知模型使用 8192 token 的估算预算。手动设置至少为 1024 token。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "留空使用已知模型的上限；未知模型使用 8192 token 的估算預算。手動設定至少為 1024 token。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Laat leeg om die bekende modelbeperking te gebruik. Onbekende modelle gebruik 'n geskatte begroting van 8192 tokens. Voer ten minste 1024 tokens in om dit te oorskry."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "اترك فارغًا لاستخدام الحد الأقصى المعروف للنموذج. تستخدم النماذج غير المعروفة ميزانية تقديرية تبلغ 8192 رمزًا. أدخل 1024 رمزًا على الأقل لتجاوز ذلك."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Оставете празно, за да използвате известния лимит на модела. Неизвестните модели използват приблизителен бюджет от 8192 токена. Въведете поне 1024 токена, за да го заобиколите."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Deixa en blanc per utilitzar el límit del model coneixut. Els models desconeguts utilitzen un pressupost estimat de 8192 tokens. Introduir almenys 1024 tokens per sobrepassar."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Nechte prázdné pro použití známého limitu modelu. Neznámé modely používají odhadovaný rozpočet 8192 tokenů. Zadejte alespoň 1024 tokeny, abyste to přepsali."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Lad stå tomt for at bruge den kendte modelgrænse. Ukendte modeller bruger et estimeret budget på 8192 tokens. Indtast mindst 1024 tokens for at tilsidesætte."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Lass leer, um das bekannte Modelllimit zu verwenden. Unbekannte Modelle verwenden ein geschätztes Budget von 8192 Tokens. Gib mindestens 1024 Tokens ein, um dies zu überschreiben."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Αφήστε κενό για να χρησιμοποιήσετε το γνωστό όριο του μοντέλου. Τα άγνωστα μοντέλα χρησιμοποιούν εκτιμώμενο προϋπολογισμό 8192 tokens. Εισάγετε τουλάχιστον 1024 tokens για να παρακάμψετε."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Jätä tyhjäksi käyttääksesi tunnettua mallirajoitusta. Tuntemattomat mallit käyttävät arvioitua budjettia 8192 tokenia. Syötä vähintään 1024 tokenia ohittaaksesi."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Laissez vide pour utiliser la limite de modèle connue. Les modèles inconnus utilisent un budget estimé de 8192 jetons. Entrez au moins 1024 jetons pour outrepasser."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "הקשר המודל נמדד בטוקנים, לא באותיות. השאר ריק כדי להשתמש במגבלת המודל הידועה. מודלים לא ידועים משתמשים בתקציב משוער של 8192 טוקנים. הזן לפחות 1024 טוקנים כדי לדרוס."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Üresen hagyja, hogy használja a ismert modellkorlímot. Ismeretlen modellek 8192 tokenes becsült költséget használnak. Legalább 1024 tokenet kell megadni a felülírásához."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Lascia vuoto per utilizzare il limite del modello noto. I modelli sconosciuti utilizzano un budget stimato di 8192 token. Inserisci almeno 1024 token per sovrascrivere."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "モデルの既知の制限を使用するには空白のままにします。不明なモデルは8192トークンの推定予算を使用します。上書きするには少なくとも1024トークンを入力してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "알 수 없는 모델은 8192 토큰의 예상 예산을 사용합니다. 재정의하려면 최소 1024 토큰을 입력하십시오."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "La stå tomt for å bruke kjent modellgrense. Ukjente modeller bruker et estimert budsjett på 8192 tokens. Skriv inn minst 1024 tokens for å overstyre."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Laat leeg om de bekende modelgrens te gebruiken. Onbekende modellen gebruiken een geschatte budget van 8192 tokens. Voer minstens 1024 tokens in om dit te overrulen."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pozostaw puste, aby użyć znanego limitu modelu. Nieznane modele używają szacowanego budżetu 8192 tokenów. Wprowadź co najmniej 1024 tokeny, aby to nadpisać."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Deixar em branco para usar o limite conhecido do modelo. Modelos desconhecidos usam um orçamento estimado de 8192 tokens. Introduza pelo menos 1024 tokens para substituir."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Deixe em branco para usar o limite de modelo conhecido. Modelos desconhecidos usam um orçamento estimado de 8192 tokens. Insira pelo menos 1024 tokens para substituir."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Lăsați gol pentru a folosi limita cunoscută a modelului. Modelele necunoscute folosesc un buget estimat de 8192 tokeni. Introduceți cel puțin 1024 tokeni pentru a anula."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Оставьте пустым, чтобы использовать известный лимит модели. Неизвестные модели используют оценочный бюджет в 8192 токена. Введите не менее 1024 токенов, чтобы переопределить."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Оставите празно да би се користио познати лимит модела. Непознати модели користе процењен буџет од 8192 токена. Унесите најмање 1024 токена да бисте преузели."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Lämna tomt för att använda den kända modellgränsen. Okända modeller använder en uppskattad budget på 8192 tokens. Ange minst 1024 tokens för att åsidosätta."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Boş bırakmak bilinen model sınırını kullanır. Bilinmeyen modeller 8192 jetonluk tahmini bir bütçe kullanır. Geçersiz kılmak için en az 1024 jeton girin."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Залиште порожнім, щоб використовувати відомий ліміт моделі. Невідомі моделі використовують приблизний бюджет у 8192 токени. Введіть щонайменше 1024 токени, щоб перевизначити."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Để trống để sử dụng giới hạn mô hình đã biết. Các mô hình không xác định sử dụng ngân sách ước tính là 8192 token. Nhập ít nhất 1024 token để ghi đè."
        }
      }
    }
  },
