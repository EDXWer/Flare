        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztosan fel akarod oldani a felhasználó némítását?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler riattivare questo utente?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当にこのユーザーのミュートを解除しますか？"
