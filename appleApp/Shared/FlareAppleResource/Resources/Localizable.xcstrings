  "ugoira_resolution_unsupported": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This device cannot export the original size. Export at up to 1920 pixels?"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此设备无法导出原始尺寸。是否导出最长边不超过 1920 像素的视频？"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "此裝置無法匯出原始尺寸。是否匯出最長邊不超過 1920 像素的影片？"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Hierdie toestel kan nie die oorspronklike grootte eksporteer nie. Eksporteer tot 1920 pixels?"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "لا يمكن لهذا الجهاز تصدير الحجم الأصلي. هل تريد التصدير بدقة تصل إلى 1920 بكسل؟"
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Този уред не може да изнесе оригиналния размер. Износване до 1920 пиксела?"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Aquest dispositiu no pot exportar la mida original. Exportar fins a 1920 píxels?"
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Toto zařízení nemůže exportovat původní velikost. Exportovat do 1920 pixelů?"
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne enhed kan ikke eksportere original størrelse. Eksportere op til 1920 pixels?"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Dieses Gerät kann die Originalgröße nicht exportieren. Exportieren bis zu 1920 Pixel?"
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Αυτό το συσκευή δεν μπορεί να εξάγει το αρχικό μέγεθος. Εξαγωγή έως 1920 pixels;"
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Tällä laitteella ei voi viedä alkuperäistä kokoa. Vie enintään 1920 pikselillä?"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Cet appareil ne peut pas exporter la taille originale. Exporter jusqu'à 1920 pixels ?"
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "מכשיר זה אינו יכול לייצא בגודל המקורי. לייצא עד 1920 פיקסלים?"
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Ez a készülék nem tudja exportálni az eredeti méretben. Exportálhatunk legfeljebb 1920 pixélre?"
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Questo dispositivo non può esportare la dimensione originale. Esporta fino a 1920 pixel?"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "このデバイスではオリジナルサイズのエクスポートができません。最大1920ピクセルでエクスポートしますか？"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 기기에서는 원본 크기로 내보낼 수 없습니다. 최대 1920 픽셀로 내보내시겠습니까?"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne enheten kan ikke eksportere originalstørrelsen. Eksporter på opptil 1920 piksler?"
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Dit apparaat kan de originele grootte niet exporteren. Exporteren op maximaal 1920 pixels?"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "To urządzenie nie może eksportować oryginalnego rozmiaru. Eksportuj do 1920 pikseli?"
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Este dispositivo não pode exportar o tamanho original. Exportar até 1920 pixels?"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Este dispositivo não pode exportar o tamanho original. Exportar em até 1920 pixels?"
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Acest dispozitiv nu poate exporta dimensiunea originală. Exportă până la 1920 pixeli?"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Это устройство не может экспортировать оригинальный размер. Экспортировать до 1920 пикселей?"
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Овај уређај не може да извози оригиналну величину. Извозити до 1920 пиксела?"
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Denna enhet kan inte exportera originalstorleken. Exportera i upp till 1920 pixlar?"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu cihaz orijinal boyutu dışa aktaramaz. 1920 piksele kadar dışa aktar?"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Це пристрій не може експортувати оригінальний розмір. Експортувати до 1920 пікселів?"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Thiết bị này không thể xuất kích thước gốc. Xuất ở tối đa 1920 pixel?"
        }
      }
    }
  },
