  "plugin_ai_delete_message": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Delete %@, its local source, accounts, credentials, and account data from this device? This takes effect immediately."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "从本机删除 %@、本地源码及其账号、凭据和账号数据？删除后立即生效。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "從本機刪除 %@、本機原始碼及其帳號、憑證和帳號資料？刪除後立即生效。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Verwyder %@, sy plaaslike bronkode en die gekoppelde rekeninge, aanmeldbewyse en rekeningdata van hierdie toestel? Dit tree onmiddellik in werking."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "هل تريد حذف %@ وشيفرته المصدرية المحلية والحسابات المرتبطة به وبيانات اعتمادها وبياناتها من هذا الجهاز؟ يسري الحذف فورًا."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Да се изтрият ли %@, локалният му изходен код, свързаните акаунти и техните данни за вход и данни от това устройство? Изтриването влиза в сила веднага."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Voleu suprimir %@, el seu codi font local i els comptes associats, les credencials i les dades d’aquests comptes del dispositiu? La supressió és immediata."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Smazat %@, jeho lokální zdroj, účty, údaje o přihlašování a údaje účtu z tohoto zařízení? Tato akce platí okamžitě."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Slet %@, dets lokale kilder, konti, legitimationsoplysninger og kontodata fra denne enhed? Dette træder i kraft med det samme."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "%@, den lokalen Quellcode sowie zugehörige Konten, Anmeldedaten und Kontodaten von diesem Gerät löschen? Das Löschen wird sofort wirksam."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Να διαγραφούν από αυτήν τη συσκευή το %@, ο τοπικός πηγαίος κώδικάς του, οι σχετικοί λογαριασμοί, τα διαπιστευτήρια και τα δεδομένα τους; Η διαγραφή ισχύει αμέσως."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Poista %@, sen paikallinen lähde, tilit, tunnukset ja tilidata tältä laitteelta? Tämä astuu voimaan välittömästi."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Supprimer de cet appareil %@, son code source local ainsi que les comptes associés, leurs identifiants et leurs données ? La suppression prend effet immédiatement."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "למחוק מהמכשיר הזה את %@, את קוד המקור המקומי שלו ואת החשבונות המשויכים, פרטי ההתחברות והנתונים שלהם? המחיקה תיכנס לתוקף מיד."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Törli az %@-et, annak helyi forrását, fiókokat, hitelesítő adatait és fiókadatokat erről a készülékről? Ez azonnal érvényes."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Eliminare %@, la sua fonte locale, account, credenziali e dati dell'account da questo dispositivo? Questo avrà effetto immediatamente."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "%@、そのローカルソースコード、および関連するアカウント、認証情報、アカウントデータをこの端末から削除しますか？削除はすぐに反映されます。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "%@ 및 로컬 소스, 계정, 자격 증명 및 계정 데이터를 이 기기에서 삭제하시겠습니까? 즉시 적용됩니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Slette %@, dets lokale kilder, kontoer, legitimasjon og kontodata fra denne enheten? Dette trer i kraft umiddelbart."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "%@, de lokale broncode en de bijbehorende accounts, inloggegevens en accountgegevens van dit apparaat verwijderen? Ze worden direct verwijderd."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Czy usunąć %@, jego lokalne źródło, konta, dane uwierzytelniające i dane konta z tego urządzenia? Zmiana nastąpi natychmiast."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Eliminar %@, o respetivo código-fonte local e as contas associadas, incluindo as credenciais e os dados dessas contas, deste dispositivo? A eliminação tem efeito imediato."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Excluir %@, o código-fonte local e as contas associadas, suas credenciais e seus dados deste dispositivo? A exclusão tem efeito imediato."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Ștergi %@, codul său sursă local, conturile asociate, datele de autentificare și datele acestor conturi de pe acest dispozitiv? Ștergerea are efect imediat."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Удалить с этого устройства %@, его локальный исходный код, связанные аккаунты, их учётные данные и данные этих аккаунтов? Удаление произойдёт сразу."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Обрисати %@, његов локални изворни кôд, повезане налоге, податке за пријаву и податке налога са овог уређаја? Брисање ступа на снагу одмах."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Radera %@, dess lokala källa, konton, inloggningsuppgifter och kontodata från denna enhet? Detta träder i kraft omedelbart."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "%@'i, yerel kaynağını, hesaplarını, kimlik bilgilerini ve hesap verilerini bu cihazdan silmek istiyor musunuz? Bu işlem derhal geçerli olur."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Видалити з цього пристрою %@, його локальний вихідний код, пов’язані облікові записи, їхні облікові дані й дані цих записів? Видалення відбудеться одразу."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Xóa %@, mã nguồn cục bộ cùng các tài khoản liên kết, thông tin đăng nhập và dữ liệu của các tài khoản đó khỏi thiết bị này? Thao tác xóa có hiệu lực ngay."
        }
      }
    }
  },

