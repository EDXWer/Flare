    "appearance_limit_single_media_height_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scale down tall single attachments when expanded to reduce screen space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展开媒体时，等比缩小过高的单附件，减少屏幕占用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展開媒體時，等比縮小過高的單附件，減少螢幕佔用。"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skal hoë enkele byvoegings verklein wanneer dit uitbrei om skermruimte te verminder."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقليص المرفقات الطويلة المفردة عند التوسيع لتقليل مساحة الشاشة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намалявай размер на високите единични прикачени файлове при разширяване, за да спестиш място на екрана."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduir l'escala d'adjunts alts únics quan s'expandeixen per reduir l'espai de pantalla."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmenšit vysoké jednotlivé přílohy při rozbalení pro úsporu místa na obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaler høje enkeltvedhæftninger ned, når de udvides, for at reducere skærmpladsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertikale Einzelanhänge beim Erweitern verkleinern, um Platz auf dem Bildschirm zu sparen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μειώνει το ύψος ενός ψηλού συνημμένου όταν το ανοίγετε, ώστε να καταλαμβάνει λιγότερο χώρο στην οθόνη."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pienennä pitkiä yksittäisiä liitteitä laajennettaessa vähentääksesi näytön tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire la taille des pièces jointes verticales uniques lorsqu'elles sont développées pour réduire l'espace d'écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקטן קבצים יחידים אנכיים בעת הרחבה כדי להפחית מקום מסך."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csökkentse a magas, egyetlen melléklet méretét kibontáskor a képernyóméret csökkentése érdekében."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci le singole allegati verticali quando espansi per ridurre lo spazio sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面スペースを減らすため、縦長の単一添付ファイルは展開時に縮小します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 공간을 줄이기 위해 확장 시 세로형 단일 첨부 파일 크기 조정."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaler ned høye enkeltvedlegg når de utvides for å redusere skjermplass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verklein hoge, enkele bijlagen bij uitklappen om schermruimte te besparen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmniejsz wysokość pojedynczych załączników po rozwinięciu, aby zaoszczędzić miejsce na ekranie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir a dimensão de anexos únicos verticais ao expandir para poupar espaço no ecrã."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzir o tamanho de anexos únicos verticais ao expandir para economizar espaço na tela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redimensionează atașamentele înalte unice la expansiune pentru a reduce spațiul ecranului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уменьшать высоту одиночных вложений при разворачивании для экономии места на экране."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смањи висину јединствених прилога приликом проширења да би се смањио простор на екрану."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skala ner höga enskilda bilagor när de expanderas för att minska skärmutrymmet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran alanını azaltmak için dikey tekli ekleri genişletildiğinde küçült."
          }
        },
        "uk" : {
