  "settings_ai_config_agent_server_url_requirement": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Enter the API base URL, such as https://api.openai.com/v1. The Agent appends the selected API path."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请输入 API 基础 URL，例如 https://api.openai.com/v1。Agent 会附加所选协议的路径。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "請輸入 API 基礎網址，例如 https://api.openai.com/v1。Agent 會附加所選協定的路徑。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Voer die API-basis URL in, soos https://api.openai.com/v1. Die Agent voeg die geselekteerde API-pad by."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "أدخل عنوان URL الأساسي لواجهة برمجة التطبيقات، مثل https://api.openai.com/v1. يضيف الوكيل مسار واجهة برمجة التطبيقات المحدد."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Поставете основния URL на API, например https://api.openai.com/v1. Агентът добавя избрания път на API."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Introduïu l'URL base de l'API, com https://api.openai.com/v1. L'Agent afegeix el camí API seleccionat."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Zadejte základní URL API, např. https://api.openai.com/v1. Agent přidá vybranou cestu API."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Indtast API-base-URL, f.eks. https://api.openai.com/v1. Agenten tilføjer den valgte API-sti."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Gib die API-Basis-URL ein, z. B. https://api.openai.com/v1. Der Agent hängt den ausgewählten API-Pfad an."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Εισάγετε τη βασική URL του API, π.χ. https://api.openai.com/v1. Το Agent προσθέτει τηλεία του API που επιλέχθηκε."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Syötä API-perus-URL, esim. https://api.openai.com/v1. Agentti liittää valitun API-polun."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Entrez l'URL de base de l'API, par exemple https://api.openai.com/v1. L'Agent ajoute le chemin d'API sélectionné."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "הזן את כתובת ה-API הבסיסית, כגון https://api.openai.com/v1. האפליקציה מוסיפה את נתיב ה-API שנבחר."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Adja meg az API alap URL-t, például https://api.openai.com/v1. Az Ügynök hozzáadja a kiválasztott API útvonalat."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Inserisci l'URL base dell'API, ad esempio https://api.openai.com/v1. L'Agente aggiunge il percorso API selezionato."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "APIのベースURLを入力してください。例：https://api.openai.com/v1。エージェントは選択したAPIパスを付加します。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "API 기본 URL을 https://api.openai.com/v1와 같이 입력하십시오. 에이전트가 선택한 API 경로를 추가합니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Skriv inn API-basen URL, for eksempel https://api.openai.com/v1. Agenten legger til den valgte API-stien."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Voer de API-basis-URL in, zoals https://api.openai.com/v1. De Agent voegt het geselecteerde API-pad toe."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Wprowadź podstawowy adres URL API, np. https://api.openai.com/v1. Agent dołączy wybrany ścieżkę API."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Introduza a URL base da API, como https://api.openai.com/v1. O Agente anexa o caminho da API selecionado."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Insira a URL base da API, como https://api.openai.com/v1. O Agente anexa o caminho da API selecionado."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Introdu URL-ul de bază al API-ului, cum ar fi https://api.openai.com/v1. Agentul adaugă calea API selectată."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Введите базовый URL API, например https://api.openai.com/v1. Агент добавит выбранный путь API."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Унесите API основну URL, као што је https://api.openai.com/v1. Агент додава одабрани API пут."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Ange API-bas-URL, t.ex. https://api.openai.com/v1. Agenten lägger till den valda API-vägen."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "API temel URL'sini girin, örneğin https://api.openai.com/v1. Ajan seçilen API yolunu ekler."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Введіть базовий URL API, наприклад https://api.openai.com/v1. Агент додає обраний шлях API."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Nhập URL cơ sở API, ví dụ: https://api.openai.com/v1. Tác nhân sẽ tự động thêm đường dẫn API đã chọn."
        }
      }
    }
  },
