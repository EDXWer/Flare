    "appearance_show_post_in_media_viewer_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the author and actions, and drag up to read the post"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示作者和操作栏，上滑可阅读帖子详情"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示作者和操作列，上滑可閱讀貼文詳情"
          }
        },
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Wys die skrywer en aksies, en sleep op om die plasing te lees"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار المؤلف والإجراءات، واسحب للأعلى لقراءة المنشور"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажи автора и действията, и плъзни нагоре, за да прочетеш поста"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar l'autor i les accions, i arrastrar cap amunt per llegir la publicació"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit autora a akce, a přetáhněte nahoru, abyste přečetli příspěvek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis forfatter og handlinger, og træk op for at læse opslaget"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autor und Aktionen anzeigen und nach oben ziehen, um den Beitrag zu lesen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφάνιση συγγραφέα και ενεργειών, και σύρετε προς τα πάνω για να διαβάσετε το post"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä tekijä ja toiminnot, ja vedä ylös lukeaksesi julkaisun"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher l'auteur et les actions, et faire glisser vers le haut pour lire la publication"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג את המחבר והפעולות, וגרור למעלה כדי לקרוא את הפוסט"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutassa meg a szerzőt és a műveleteket, és húzza felfelé a poszt elolvasásához"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra autore e azioni, e trascina su per leggere il post"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投稿者とアクションを表示し、投稿を読むには上にドラッグしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작성자와 동작을 표시하고 게시물을 읽으려면 위로 드래그하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis forfatter og handlinger, og dra opp for å lese innlegget"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon auteur en acties, en veeg omhoog om de post te lezen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż autora i akcje, a przeciągnij w górę, aby przeczytać post"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar o autor e as ações, e deslizar para cima para ler a publicação"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar autor e ações, e deslizar para cima para ler a publicação"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arată autorul și acțiunile, și trage în sus pentru a citi postarea"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать автора и действия, и свайпнуть вверх, чтобы прочитать пост"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикажи аутора и акције, и повуците нагоре да прочитате објаву"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa författare och åtgärder, och dra upp för att läsa inlägget"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazar ve eylemleri göster, gönderiyi okumak için yukarı sürükle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показувати автора та дії, і перетягувати вгору, щоб прочитати допис"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tác giả và hành động, và kéo lên để đọc bài đăng"
          }
        }
      }
    },
