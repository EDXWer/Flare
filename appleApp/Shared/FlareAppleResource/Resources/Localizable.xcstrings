          "stringUnit" : {
            "state" : "translated",
            "value" : "할 말이 정말 많으시네요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er sikker på at du har mye å si."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt vast veel te vertellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z pewnością masz wiele do powiedzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De certeza que tens muito a dizer."
          }
