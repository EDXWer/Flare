  "plugin_uninstall_confirm_message": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Delete %@ and its accounts, credentials, and account data from this device? This takes effect immediately."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "从本机删除 %@ 及其账号、凭据和账号数据？删除后立即生效。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "從本機刪除 %@ 及其帳號、憑證和帳號資料？刪除後立即生效。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Verwyder %@ en die gekoppelde rekeninge, aanmeldbewyse en rekeningdata van hierdie toestel? Dit tree onmiddellik in werking."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "هل تريد حذف %@ والحسابات المرتبطة به وبيانات اعتمادها وبياناتها من هذا الجهاز؟ يسري الحذف فورًا."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Искате ли да изтриете %@ и неговите акаунти, данни за вход и данни за акаунта от това устройство? Това влиза в сила незабавно."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Voleu suprimir %@ i els comptes associats, les credencials i les dades d’aquests comptes del dispositiu? La supressió és immediata."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Vymazat %@ a jeho účty, údaje a údaje o účtech z tohoto zařízení? Tato změna platí okamžitě."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Slet %@ og dets konti, legitimationsoplysninger og kontodata fra denne enhed? Dette træder i kraft øjeblikkeligt."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "%@ und die zugehörigen Konten, Anmeldedaten und Kontodaten von diesem Gerät löschen? Das Löschen wird sofort wirksam."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Να διαγραφούν από αυτήν τη συσκευή το %@ και οι σχετικοί λογαριασμοί, τα διαπιστευτήρια και τα δεδομένα τους; Η διαγραφή ισχύει αμέσως."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Poistetaanko %@ ja sen tilit, tunnukset ja tilidata tältä laitteelta? Tämä astuu voimaan välittömästi."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Supprimer de cet appareil %@ ainsi que les comptes associés, leurs identifiants et leurs données ? La suppression prend effet immédiatement."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "למחוק מהמכשיר הזה את %@ ואת החשבונות המשויכים, פרטי ההתחברות והנתונים שלהם? המחיקה תיכנס לתוקף מיד."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Törlés az %@-ből és annak fiókaiból, hitelesítő adataiból és fiókadataiból erről a készülékről? Ez azonnal érvényesül."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Eliminare %@ e i suoi account, credenziali e dati dell'account da questo dispositivo? Questo avrà effetto immediatamente."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "%@ と、関連するアカウント、認証情報、アカウントデータをこの端末から削除しますか？削除はすぐに反映されます。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 장치에서 %@ 및 해당 계정, 자격 증명 및 계정 데이터를 삭제하시겠습니까? 이는 즉시 적용됩니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Slette %@ og kontoene, legitimasjonene og kontodataene fra denne enheten? Dette trer i kraft umiddelbart."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "%@ en de bijbehorende accounts, inloggegevens en accountgegevens van dit apparaat verwijderen? Ze worden direct verwijderd."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Czy usunąć %@ wraz z jego kontami, danymi uwierzytelniającymi i danymi konta z tego urządzenia? Wchodzi w życie natychmiast."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Eliminar %@ e as contas associadas, incluindo as credenciais e os dados dessas contas, deste dispositivo? A eliminação tem efeito imediato."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Excluir %@ e as contas associadas, suas credenciais e seus dados deste dispositivo? A exclusão tem efeito imediato."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Ștergi %@, conturile asociate, datele de autentificare și datele acestor conturi de pe acest dispozitiv? Ștergerea are efect imediat."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Удалить с этого устройства %@, связанные аккаунты, их учётные данные и данные этих аккаунтов? Удаление произойдёт сразу."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Обрисати %@ и повезане налоге, податке за пријаву и податке налога са овог уређаја? Брисање ступа на снагу одмах."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Ta bort %@ och dess konton, inloggningsuppgifter och kontodata från denna enhet? Detta träder i kraft omedelbart."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "%@'i ve bu cihazdaki hesaplarını, kimlik bilgilerini ve hesap verilerini silmek istiyor musunuz? Bu derhal geçerli olur."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Видалити з цього пристрою %@, пов’язані облікові записи, їхні облікові дані й дані цих записів? Видалення відбудеться одразу."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Xóa %@ và các tài khoản, thông tin xác thực và dữ liệu tài khoản của nó khỏi thiết bị này? Việc này có hiệu lực ngay lập tức."
        }
      }
    }
  },
  "plugin_operation_failed": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The plugin operation failed. Try again or restart Flare."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "插件操作失败。请重试或重新启动 Flare。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Die plugin-operasie het misluk. Probeer weer of herlaai Flare."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "فشل تشغيل الإضافة. حاول مرة أخرى أو أعد تشغيل Flare."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Операцията на плагина не успя. Опитайте отново или рестартирайте Flare."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "L'operació del plugin ha fallat. Intenta de nou o reinicia Flare."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Operace pluginu selhala. Zkuste to znovu nebo restartujte Flare."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Plugin-operationen mislykkedes. Prøv igen eller genstart Flare."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Die Plugin-Operation ist fehlgeschlagen. Versuche es erneut oder starte Flare neu."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Η λειτουργία του plugin απέτυχε. Δοκιμάστε ξανά ή επανεκκινήστε το Flare."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Plugin-toiminto epäonnistui. Yritä uudelleen tai käynnistä Flare uudelleen."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "L'opération du plugin a échoué. Réessayez ou redémarrez Flare."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "פעולת התוסף נכשלה. נסה שוב או הפעל מחדש את Flare."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "A plugin művelete sikertelen. Próbálja újra, vagy indítsa újra az Flare-et."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "L'operazione del plugin è fallita. Riprova o riavvia Flare."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "プラグインの操作に失敗しました。再試行するか、Flareを再起動してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "플러그인 작업에 실패했습니다. 다시 시도하거나 Flare를 다시 시작하십시오."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Pluginoperasjonen feilet. Prøv igjen eller start Flare på nytt."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "De plugin-operatie is mislukt. Probeer het opnieuw of start Flare opnieuw op."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Operacja pluginu się nie powiodła. Spróbuj ponownie lub uruchom ponownie Flare."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "A operação do plugin falhou. Tente novamente ou reinicie Flare."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "A operação do plugin falhou. Tente novamente ou reinicie o Flare."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Operațiunea plugin-ul a eșuat. Încercați din nou sau reporniți Flare."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Операция плагина не удалась. Попробуйте снова или перезапустите Flare."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Операција плагина је неуспела. Покушајте поново или поново покрените Flare."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Pluginoperationen misslyckades. Försök igen eller starta Flare."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Eklenti işlemi başarısız oldu. Tekrar deneyin veya Flare'i yeniden başlatın."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Операція плагіна не вдалася. Спробуйте ще раз або перезапустіть Flare."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Thao tác plugin thất bại. Thử lại hoặc khởi động lại Flare."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "外掛程式操作失敗。請重試或重新啟動 Flare。"
        }
      }
    }
  },
  "plugin_issue_index_corrupt": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The plugin index is damaged. Rebuild it to recover valid packages."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "插件索引已损坏。请重建索引以恢复有效的插件包。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Die plugin-indeks is beskadig. Herbou dit om geldige pakkette te herstel."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "فهرس الإضافات تالف. أعد بناؤه لاستعادة الحزم الصالحة."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Индексът на плагина е поврежден. Преизградете го, за да възстановите валидни пакети."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "El format de credencials ha canviat. Les comptes existents poden necessitar iniciar sessió de nou, fins i tot després de tornar a la versió instal·lada."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Index pluginů je poškozen. Přepište ho, abyste obnovili platné balíčky."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Plugin-indekset er beskadiget. Genopbyg det for at gendanne gyldige pakker."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Der Plugin-Index ist beschädigt. Erstelle ihn neu, um gültige Pakete wiederherzustellen."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Ο δείκτης των plugins έχει καταστραφεί. Δημιουργήστε ξανά για να ανακτήσετε έγκυρα πακέτα."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Plugin-indeksi on vioittunut. Uudelleenrakenna se palauttaaksesi kelvolliset paketit."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
