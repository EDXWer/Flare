  "settings_remember_home_timeline_position_description": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Keep your place when refreshing and restore your last tab and position when opening the app."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "刷新时保留当前位置，启动时恢复上次的标签页和阅读位置。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Hou jou plek wanneer jy verfris en herstel jou laaste tab en posisie wanneer jy die toepassing oopmaak."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "حافظ على مكانك عند التحديث واستعد آخر علامة تبويب وموضع عند فتح التطبيق."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Запазете мястото си при презареждане и възстановете последната си заявка и позиция при отваряне на приложението."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Mantén el teu lloc quan refresques i restaura la teva última pestanya i posició quan obres l'aplicació."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Zachovejte své místo při obnovení a obnovte poslední záložku a pozici při otevření aplikace."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Bevar din plads ved genindlæsning og gendanlæg din sidste fane og position ved åbning af appen."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Behält deinen Platz beim Aktualisieren bei und stellt deinen letzten Tab und deine Position beim Öffnen der App wieder her."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Διατηρεί τη θέση σας κατά την ανανέωση και επαναφέρει την τελευταία καρτέλα και θέση όταν ανοίγετε την εφαρμογή."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Säilytä paikkasi päivittämisen yhteydessä ja palauta viimeisin välilehti ja sijainti sovelluksen avaamisessa."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Gardez votre place lors du rafraîchissement et restaurez votre dernier onglet et votre position lors de l'ouverture de l'application."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "שמור על המקום שלך בעת רענון והחזר את הלשונית והמיקום האחרונים שלך בעת פתיחת האפליקציה."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Tartsa meg a helyét frissítéskor, és helyreállítsa az utolsó lapját és pozícióját az alkalmazás megnyitásakor."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Mantieni il tuo punto durante il refresh e ripristina l'ultima scheda e posizione all'apertura dell'app."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "更新したり再度開いたりした後も場所を保持します。新しい投稿に移動するには「最新を表示」を使用してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "새로 고침 시 위치 유지 및 앱 열 때 마지막 탭과 위치 복원"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Beholder plass ved oppdatering og gjenoppretter siste fane og posisjon ved åpning av appen."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Houd je plek bij bij vernieuwen en herstel je laatste tab en positie bij het openen van de app."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Zachowaj swoje miejsce podczas odświeżania i przywróć ostatnią zakładkę i pozycję po otwarciu aplikacji."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Mantenha o seu lugar ao atualizar e restaure a sua última aba e posição ao abrir a aplicação."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Mantenha seu lugar ao atualizar e restaure sua última aba e posição ao abrir o aplicativo."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Menține locul la reîmprospătare și restabilește ultima tab și poziție la deschiderea aplicației."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Сохраняет ваше место при обновлении и восстанавливает последнюю вкладку и позицию при открытии приложения."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Останите на месту при освежавању и вратите своју последњу табелу и позицију при отварању апликације."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Behålla din plats vid uppdatering och återställa din senaste flik och position vid öppning av appen."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Yenilediğinizde yerinizi koruyun ve uygulamayı açtığınızda son sekmenizi ve konumunuzu geri yükleyin."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Зберігайте своє місце при оновленні та відновлюйте останню вкладку та позицію при відкритті програми."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Giữ vị trí của bạn khi làm mới và khôi phục tab và vị trí cuối cùng của bạn khi mở ứng dụng."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "刷新時保持位置，並在開啟應用程式時恢復最後一個分頁和位置。"
        }
      }
    }
  },
