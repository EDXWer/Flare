        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke lagre avspillingshastighet. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon afspeelsnelheid niet opslaan. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
