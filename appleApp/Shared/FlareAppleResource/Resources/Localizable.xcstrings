  "plugin_large_repository_message": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This repository download exceeds 20 MiB and will use more data and storage. Continue downloading?"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此仓库下载超过 20 MiB，会使用更多流量和存储空间。是否继续下载？"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Hierdie repositorium-aflaaiing oorskry 20 MiB en sal meer data en berging gebruik. Deurgaan met aflaai?"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "يتجاوز تنزيل هذا المستودع 20 MiB وسيستخدم المزيد من البيانات والتخزين. هل تواصل التنزيل؟"
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Изтеглянето от този репозиториум надвишава 20 MiB и ще използва повече данни и съхранение. Продължавате с изтеглянето?"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Aquest descàrrega de repòsitori supera els 20 MiB i utilitzarà més dades i emmagatzematge. Continuar amb el descàrrega?"
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Stahování z tohoto úložiště přesahuje 20 MiB a bude vyžadovat více dat a úložiště. Pokračovat ve stahování?"
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne repository-download overstiger 20 MiB og vil bruge mere data og lagerplads. Fortsæt med at downloade?"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Der Download dieses Repositorys ist größer als 20 MiB und verbraucht mehr Datenvolumen und Speicherplatz. Download fortsetzen?"
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Η λήψη από αυτό το repository υπερβαίνει τα 20 MiB και θα χρησιμοποιήσει περισσότερα δεδομένα και αποθηκευτικό χώρο. Συνεχίσετε τη λήψη;"
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Tämä arkiston lataus ylittää 20 MiB ja käyttää enemmän dataa ja tallennustilaa. Jatka lataamista?"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Le téléchargement de ce dépôt dépasse 20 MiB et consommera plus de données et d’espace de stockage. Continuer le téléchargement ?"
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "הורדת מאגר זה עולה על 20 MiB ותשתמש ביותר נתונים ואחסון. להמשיך בהורדה?"
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Ez a repozitórium letöltése meghaladja a 20 MiB-et, és több adatot és tárhelyet fog használni. Folytassa a letöltést?"
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Il download di questo repository supera i 20 MiB e utilizzerà più dati e spazio di archiviazione. Continuare il download?"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "このリポジトリのダウンロードには 20 MiB を超えるデータ通信と保存容量が必要です。ダウンロードを続けますか？"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 저장소 다운로드가 20 MiB를 초과하며 더 많은 데이터와 스토리지를 사용할 것입니다. 계속 다운로드하시겠습니까?"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne repository-nedlastingen overstiger 20 MiB og vil bruke mer data og lagringsplass. Fortsette nedlasting?"
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Deze repository-download overschrijdt 20 MiB en zal meer data en opslag gebruiken. Doorgaan met downloaden?"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Pobieranie z tego repozytorium przekracza 20 MiB i zużyje więcej danych i pamięci. Kontynuować pobieranie?"
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Este download do repositório excede 20 MiB e utilizará mais dados e armazenamento. Continuar o download?"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Este download de repositório excede 20 MiB e usará mais dados e armazenamento. Continuar o download?"
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Descărcarea din acest repository depășește 20 MiB și va folosi mai multe date și stocare. Continuați descărcarea?"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Загрузка из этого репозитория превышает 20 MiB и потребует больше данных и места. Продолжить загрузку?"
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Преузимање овог репозиторијума премаши 20 MiB и биће користити више података и меморије. Да ли наставити са преузимањем?"
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Denna repository-nedladdning överstiger 20 MiB och kommer att använda mer data och lagring. Fortsätta ladda ner?"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu depo indirmesi 20 MiB'i aşıyor ve daha fazla veri ve depolama kullanacak. İndirmeye devam et?"
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Завантаження з цього репозиторію перевищує 20 MiB і використає більше даних та місця для зберігання. Продовжити завантаження?"
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Tải xuống kho lưu trữ này vượt quá 20 MiB và sẽ sử dụng nhiều dữ liệu và bộ nhớ hơn. Tiếp tục tải xuống?"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "下載此儲存庫需傳輸超過 20 MiB 的資料，並會占用更多儲存空間。要繼續下載嗎？"
        }
      }
    }
  },
