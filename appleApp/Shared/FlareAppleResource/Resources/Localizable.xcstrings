  "proxy_error_in_use": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Reassign accounts and the global policy before deleting this proxy"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "请先修改使用此代理的账号和全局设置，再删除代理"}},
