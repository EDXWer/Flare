        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말로 이 사용자의 뮤트를 해제하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på at du vil oppheve dempingen av denne brukeren?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je het dempen van deze gebruiker wilt opheffen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
