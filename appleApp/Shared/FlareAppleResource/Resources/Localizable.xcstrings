  "visibility_friends_description": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Only people who follow you and whom you follow can see this post"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "仅互相关注的好友可以看到此微博"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "僅互相關注的好友可以看到此微博"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Speel animasie"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "تشغيل الرسوم المتحركة"
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Това съобщение може да бъде видимо само за хора, които ви следват и които ви следвате"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Només les persones que et segueixen i que tu segueixes poden veure aquesta publicació"
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Zobrazit analýzu AI tohoto příspěvku"
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Kun folk der følger dig og som du følger kan se dette opslag"
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Nur Personen, die dir folgen und denen du folgst, können diesen Beitrag sehen"
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Μόνο οι άνθρωποι που σας ακολουθούν και εσείς τους ακολουθείτε μπορούν να δουν αυτή τη δημοσίευση"
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Vain ne, jotka seuraavat sinua ja joiden seuraat, näkevät tämän julkaisun"
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Seuls les personnes qui vous suivent et que vous suivez peuvent voir ce message"
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "רק אנשים שמקבלים אותך ואתה מקבל אותם יכולים לראות פוסט זה"
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Csak azok láthatják ezt a bejegyzést, akik követik Önt, és akiket Ön követ."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Visualizza approfondimento del post"
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "あなたをフォローしている人、およびあなたがフォローしている人だけがこの投稿を見ることができます"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "팔로우하는 사람과 나를 팔로우하는 사람만 이 게시물을 볼 수 있습니다"
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Kun folk som følger deg og som du følger kan se dette innlegget"
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Alleen mensen die je volgen en die jij volgt kunnen deze post zien"
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Tylko osoby, które Cię obserwują i których Ty obserwujesz, mogą zobaczyć ten post"
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Apenas as pessoas que o seguem e que o segue podem ver esta publicação"
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Apenas pessoas que te seguem e que você segue podem ver esta publicação"
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Doar persoanele care te urmăresc și pe care le urmărești pot vedea această postare"
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Только люди, которые на вас подписаны и на которых вы подписаны, могут видеть этот пост"
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Само људи који вас прате и које ви пратите могу да виде ову објаву"
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Endast personer som följer dig och som du följer kan se detta inlägg"
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu gönderiyi yalnızca sizi takip edenler ve sizin takip ettikleriniz görebilir."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Цей допис можуть бачити лише ті, хто підписаний на вас і кого ви підписали"
