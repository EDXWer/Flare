    "settings_mxga_filter_description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide matching X posts using MXGA’s public account list and text rules. When enabled, updates are checked every 24 hours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 MXGA 的公开账号名单和文字规则隐藏匹配的 X 帖子。启用后每 24 小时检查一次更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 MXGA 的公開帳號名單和文字規則隱藏符合的 X 貼文。啟用後每 24 小時檢查一次更新。"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء مطابقة المشاركات X باستخدام قائمة الحساب العام وقواعد النصوص. عند التمكين، يتم التحقق من التحديثات كل 24 ساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrýt odpovídající X příspěvky pomocí veřejného seznamu a textových pravidel MXGA. Pokud je povoleno, aktualizace jsou kontrolovány každých 24 hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul matchende X indlæg ved hjælp af MXGAs offentlige kontoliste og tekstregler. Når aktiveret, tjekkes opdateringer hver 24. time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstecke passende X-Beiträge mit MXGAs öffentlichen Accountliste und Textregeln. Wenn aktiviert, werden Updates alle 24 Stunden überprüft."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απόκρυψη ταιριαστών X δημοσιεύσεων χρησιμοποιώντας τη λίστα δημόσιων λογαριασμών και τους κανόνες κειμένου του MXGA. Όταν είναι ενεργοποιημένο, οι ενημερώσεις ελέγχονται κάθε 24 ώρες."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota vastaavat X viestit käyttäen MXGA:n julkista tiliä ja tekstiä. Kun käytössä, päivitykset tarkistetaan 24 tunnin välein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les messages X correspondants en utilisant la liste des comptes publics et les règles de texte de MXGA. Lorsque cette option est activée, les mises à jour sont vérifiées toutes les 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi i messaggi corrispondenti a X usando la lista degli account pubblici e le regole di testo di MXGA. Quando abilitato, gli aggiornamenti vengono controllati ogni 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MXGAの公開アカウントリストとテキストルールを使用して、一致するX投稿を非表示にします。有効にすると、24時間ごとに更新がチェックされます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg overeenkomende X-berichten met de openbare accountlijst en tekstregels van MXGA. Wanneer ingeschakeld, worden updates elke 24 uur aangevinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryj pasujące posty X przy użyciu listy kont publicznych MXGA i reguł tekstowych. Gdy włączone, aktualizacje są sprawdzane co 24 godziny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar postagens X correspondentes usando a lista de conta pública do MXGA e as regras de texto. Quando ativado, as atualizações são verificadas a cada 24 horas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar postagens X correspondentes usando a lista de conta pública do MXGA e as regras de texto. Quando ativado, as atualizações são verificadas a cada 24 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascunde posturile X care se potrivesc folosind lista contului public și regulile de text ale MXGA. Când este activat, actualizările sunt verificate la fiecare 24 de ore."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывать соответствие X сообщений, используя список учетных записей MXGA и текстовые правила. Когда включено, обновление проверяется каждые 24 часа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj matchande X-inlägg med hjälp av MXGA:s lista över offentliga konton och textregler. När detta är aktiverat kontrolleras uppdateringar var 24:e timme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приховати відповідні X повідомлень, використовуючи список публічних облікових записів та текстові правила. Коли це увімкнено, оновлення перевіряються кожні 24 години."
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteek ooreenstemmende X-plasings met MXGA se publieke rekeninglys en teksreëls. Wanneer dit geaktiveer is, word opdaterings elke 24 uur nagegaan."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скриване на съвпадащи публикации в X чрез публичния списък с профили и текстовите правила на MXGA. Когато е включено, актуализациите се проверяват на всеки 24 часа."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amaga les publicacions d'X coincidents mitjançant la llista pública de comptes i les regles de text de MXGA. Quan està activat, es comproven les actualitzacions cada 24 hores."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסתרת פוסטים תואמים ב-X באמצעות רשימת החשבונות הציבורית וכללי הטקסט של MXGA. כשהאפשרות מופעלת, העדכונים נבדקים כל 24 שעות."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az MXGA nyilvános fióklistája és szöveges szabályai alapján elrejti az egyező X-bejegyzéseket. Bekapcsolva a frissítések 24 óránként lesznek ellenőrizve."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MXGA의 공개 계정 목록과 텍스트 규칙을 사용해 일치하는 X 게시물을 숨깁니다. 활성화하면 24시간마다 업데이트를 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul matchende X-innlegg med bruk av MXGAs offentlige kontoliste og tekstregler. Når dette er aktivert, kontrolleres oppdateringer hver 24. time."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сакриј подударајуће X објаве помоћу јавног списка налога и текстуалних правила MXGA. Када је укључено, ажурирања се проверавају свака 24 сата."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MXGA'nın herkese açık hesap listesini ve metin kurallarını kullanarak eşleşen X gönderilerini gizle. Etkinleştirildiğinde güncellemeler 24 saatte bir denetlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ẩn các bài đăng X khớp với danh sách tài khoản công khai và quy tắc văn bản của MXGA. Khi bật, các bản cập nhật được kiểm tra mỗi 24 giờ."
          }
        }
      }
    },
