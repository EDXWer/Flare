  "proxy_error_port": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Port must be between 1 and 65535"}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "端口必须介于 1 和 65535 之间"}},
