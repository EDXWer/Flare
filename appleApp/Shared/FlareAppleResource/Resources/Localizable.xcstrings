  "proxy_webview_error": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "The webpage could not be loaded with the global proxy settings. Check the proxy and try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法使用全局代理设置加载网页。请检查代理后重试。"}}, "zh-Hant": {"stringUnit": {"state": "translated", "value": "無法使用全域代理設定載入網頁。請檢查代理後重試。"}},
  "af": {
    "stringUnit": {
      "state": "translated",
      "value": "Die webblad kon nie met die globale proxy-instellings gelaai word nie. Kontroleer die proxy en probeer weer."
    }
  },
  "ar": {
    "stringUnit": {
      "state": "translated",
      "value": "لم يتم تحميل صفحة الويب باستخدام إعدادات الوكيل العامة. تحقق من الوكيل وحاول مرة أخرى."
    }
  },
  "bg": {
    "stringUnit": {
      "state": "translated",
      "value": "Уеб страницата не може да бъде затоварена с глобалните настройки на прокси. Проверете проксито и опитайте отново."
    }
  },
  "ca": {
    "stringUnit": {
      "state": "translated",
      "value": "La pàgina web no s'ha puig carregar amb la configuració global del proxy. Comprova el proxy i intenta de nou."
    }
  },
  "cs": {
    "stringUnit": {
      "state": "translated",
      "value": "Webovou stránku nelze načíst s globálními proxy nastaveními. Zkontrolujte proxy a zkuste znovu."
    }
  },
  "da": {
    "stringUnit": {
      "state": "translated",
      "value": "Websiden kunne ikke indlæses med de globale proxyindstillinger. Tjek proxyen og prøv igen."
    }
  },
  "de": {
    "stringUnit": {
      "state": "translated",
      "value": "Die Webseite konnte nicht mit den globalen Proxy-Einstellungen geladen werden. Überprüfe den Proxy und versuche es erneut."
    }
  },
  "el": {
    "stringUnit": {
      "state": "translated",
      "value": "Η σελίδα δεν μπορούσε να φορτωθεί με τις παγκόσμιες ρυθμίσεις proxy. Ελέγξτε το proxy και δοκιμάστε ξανά."
    }
  },
  "fi": {
    "stringUnit": {
      "state": "translated",
      "value": "Verkkosivua ei voitu ladata globaaleilla välityspalvelimen asetuksilla. Tarkista välityspalvelin ja yritä uudelleen."
    }
  },
  "fr": {
    "stringUnit": {
      "state": "translated",
      "value": "La page web n'a pas pu être chargée avec les paramètres de proxy globaux. Vérifiez le proxy et réessayez."
    }
  },
  "he": {
    "stringUnit": {
      "state": "translated",
      "value": "לא ניתן היה לטעון את דף האינטרנט עם הגדרות הפרוקסי הגלובליות. בדוק את הפרוקסי ונסה שוב."
    }
  },
  "hu": {
    "stringUnit": {
      "state": "translated",
      "value": "A weboldal nem tudott betöltődni a globális proxy beállításokkal. Ellenőrizze a proxy-t, majd próbálja újra."
    }
  },
  "it": {
    "stringUnit": {
      "state": "translated",
      "value": "La pagina web non è stata caricata con le impostazioni proxy globali. Controlla il proxy e riprova."
    }
  },
  "ja": {
    "stringUnit": {
      "state": "translated",
      "value": "グローバルプロキシ設定ではウェブページを読み込めませんでした。プロキシを確認し、もう一度お試しください。"
    }
  },
  "ko": {
    "stringUnit": {
      "state": "translated",
      "value": "전역 프록시 설정으로 웹페이지를 로드할 수 없습니다. 프록시를 확인하고 다시 시도하십시오."
    }
  },
  "nb": {
    "stringUnit": {
      "state": "translated",
      "value": "Nettsiden kunne ikke lastes inn med de globale proxyinnstillingene. Sjekk proxyen og prøv igjen."
    }
  },
  "nl": {
    "stringUnit": {
      "state": "translated",
      "value": "De webpagina kon niet worden geladen met de globale proxy-instellingen. Controleer de proxy en probeer het opnieuw."
    }
  },
  "pl": {
    "stringUnit": {
      "state": "translated",
      "value": "Nie można załadować strony internetowej z globalnymi ustawieniami proxy. Sprawdź proxy i spróbuj ponownie."
    }
  },
  "pt": {
    "stringUnit": {
      "state": "translated",
      "value": "A página web não pôde ser carregada com as definições de proxy global. Verifique o proxy e tente novamente."
    }
  },
  "pt-BR": {
    "stringUnit": {
      "state": "translated",
      "value": "A página da web não pôde ser carregada com as configurações de proxy global. Verifique o proxy e tente novamente."
    }
  },
  "ro": {
    "stringUnit": {
      "state": "translated",
      "value": "Pagina web nu a putut fi încărcată cu setările de proxy globale. Verifică proxy-ul și încearcă din nou."
    }
  },
  "ru": {
    "stringUnit": {
      "state": "translated",
      "value": "Страницу не удалось загрузить с глобальными настройками прокси. Проверьте прокси и повторите попытку."
    }
  },
  "sr": {
    "stringUnit": {
      "state": "translated",
      "value": "Веб страница није могла бити учитана са глобалним прокси подешавањима. Проверите прокси и покушајте поново."
    }
  },
  "sv": {
    "stringUnit": {
      "state": "translated",
      "value": "Webbplatsen kunde inte laddas med de globala proxyinställningarna. Kontrollera proxyn och försök igen."
    }
  },
  "tr": {
    "stringUnit": {
      "state": "translated",
      "value": "Web sayfası küresel proxy ayarlarıyla yüklenemedi. Proxy'yi kontrol edin ve tekrar deneyin."
    }
  },
  "uk": {
    "stringUnit": {
      "state": "translated",
      "value": "Сторінку не вдалося завантажити з глобальними налаштуваннями проксі. Перевірте проксі та спробуйте ще раз."
    }
  },
  "vi": {
    "stringUnit": {
      "state": "translated",
      "value": "Không thể tải trang web với cài đặt proxy toàn cục. Vui lòng kiểm tra proxy và thử lại."
    }
  }
}},
