    "Choose how much effort the model spends on reasoning. Default uses the provider's default behavior." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies hoeveel moeite die model aan beredenering bestee. Verstek gebruik die verskaffer se verstekgedrag."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مقدار الجهد الذي يبذله النموذج في التفكير. يستخدم الافتراضي سلوك المزود الافتراضي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете колко усилия да полага моделът за разсъждение. По подразбиране се използва поведението на доставчика по подразбиране."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria quant esforç dedica el model al raonament. El valor predeterminat utilitza el comportament predeterminat del proveïdor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte, kolik úsilí model věnuje uvažování. Výchozí nastavení používá výchozí chování poskytovatele."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
