  "plugin_github_path_hint": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "For a plugin in a subdirectory, add ?path=/plugins/example to the URL."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "安装子目录中的插件时，在链接末尾添加 ?path=/plugins/example。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Vir 'n plugin in 'n subdirektorie, voeg ?path=/plugins/example by die URL."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "بالنسبة لإضافة في مجلد فرعي، أضف ?path=/plugins/example إلى عنوان URL."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "За плагин в поддиректория, добавете ?path=/plugins/example към URL-адресата."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Per a un plugin en un subdirectori, afegeix ?path=/plugins/example a l'URL."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Pro plugin v podadresáři přidejte ?path=/plugins/example do URL."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "For en plugin i en undermappe, tilføj ?path=/plugins/example til URL'en."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Für ein Plugin in einem Unterverzeichnis, füge ?path=/plugins/example zur URL hinzu."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Για ένα plugin σε υποδιεύθυνση, προσθέστε το ?path=/plugins/example στη URL."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Lisää ?path=/plugins/example URL-osoitteeseen lisäosan alikansiossa."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Pour un plugin dans un sous-dossier, ajoutez ?path=/plugins/example à l'URL."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "עבור תוסף בתיקייה משנה, הוסף את ?path=/plugins/example לכתובת ה-URL."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Egy alpontban lévő pluginhez adja hozzá az ?path=/plugins/example-et az URL-hez."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Per un plugin in una sottocartella, aggiungi ?path=/plugins/example all'URL."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "サブディレクトリ内のプラグインの場合、URLに?path=/plugins/exampleを追加してください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "하위 디렉터리에 있는 플러그인의 경우, URL에 ?path=/plugins/example를 추가하십시오."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "For en plugin i en undermappe, legg til ?path=/plugins/example i URL-en."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Voor een plugin in een submap, voeg ?path=/plugins/example toe aan de URL."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Dla wtyczki w podkatalogu dodaj ?path=/plugins/example do adresu URL."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Para um plugin numa subpasta, adicione ?path=/plugins/example à URL."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Para um plugin em um subdiretório, adicione ?path=/plugins/example à URL."
        }
      },
      "ro": {
