    "plugin_extension_automatic_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try once each day when you open or return to Flare. Retry failed or interrupted tasks manually. Timezone: %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天打开或返回 Flare 时尝试一次。失败或中断后需手动重试。时区：%1$@。"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer een keer per dag wanneer jy Flare oopmaak of terugkom. Probeer mislukte of onderbreekde take handmatig weer. Tydsone: %1$@."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول مرة واحدة كل يوم عند فتح Flare أو العودة إليه. أعد تشغيل المهام الفاشلة أو المتقطعة يدويًا. المنطقة الزمنية: %1$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опитайте веднъж на ден, когато отворите или се върнете в Flare. Откарайте ръчно неуспешни или прекъснати задачи. Времева зона: %1$@."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenteu una vegada cada dia quan obriu o torneu a Flare. Reintenteu manualment les tasques fallides o interrompudes. Zona horària: %1$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste jednou denně při otevření nebo návratu do Flare. Ručně zkuste selhání nebo přerušení úkolů. Časová zóna: %1$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv én gang hver dag, når du åbner eller vender tilbage til Flare. Genstart fejlede eller afbrudte opgaver manuelt. Tidszone: %1$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versucht beim Öffnen von Flare oder bei der Rückkehr zur App einmal pro Tag, die Aufgabe auszuführen. Fehlgeschlagene oder unterbrochene Aufgaben müssen manuell erneut gestartet werden. Zeitzone: %1$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάστε μία φορά την ημέρα όταν ανοίγετε ή επιστρέφετε στο Flare. Επαναλάβετε χειροκίνητα τις αποτυχημένες ή διακομισμένες εργασίες. Ζώνη ώρας: %1$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kokeile kerran päivässä, kun avaat tai palaat Flare:ään. Toista epäonnistuneet tai keskeytetyt tehtävät manuaalisesti. Aikavyöhyke: %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une tentative par jour à l’ouverture de Flare ou au retour dans l’application. Relancez manuellement les tâches en échec ou interrompues. Fuseau horaire : %1$@."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נסה פעם ביום כשאתה פותח או חוזר ל-Flare. בצע מחדש משימות שנכשלו או הופסקו ידנית. אזור זמן: %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbálja meg naponta egyszer, amikor megnyitja vagy visszatér a Flare-hez. Manuálisan próbálja újra a sikertelen vagy megszakított feladatokat. Időzóna: %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova una volta al giorno quando apri o rientri in Flare. Riprova manualmente compiti falliti o interrotti. Fuso orario: %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flare を開くかアプリに戻ったときに、1 日に 1 回だけ実行を試みます。失敗または中断したタスクは手動で再実行してください。タイムゾーン：%1$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flare를 열거나 다시 방문할 때 하루에 한 번 시도해 주십시오. 실패했거나 중단된 작업은 수동으로 다시 시도하십시오. 시간대: %1$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv én gang hver dag når du åpner eller returnerer til Flare. Prøv manuelt på nytt for mislykkede eller avbrutte oppgaver. Tidssone: %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer één keer per dag wanneer u Flare opent of terugkeert. Voer mislukte of onderbroken taken handmatig opnieuw uit. Tijdzone: %1$@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj raz dziennie, gdy otwierasz lub wracasz do Flare. Ręcznie spróbuj ponownie zadań, które się nie powiodły lub zostały przerwane. Strefa czasowa: %1$@."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente uma vez por dia ao abrir ou regressar ao Flare. Tente novamente tarefas falhadas ou interrompidas manualmente. Fuso horário: %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente uma vez por dia ao abrir ou retornar ao Flare. Tente novamente tarefas falhas ou interrompidas manualmente. Fuso horário: %1$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încercați o dată pe zi când deschideți sau reveniți la Flare. Reporniți manual sarcinile eșuate sau întrerupte. Zona orară: %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте один раз в день при открытии или возвращении в Flare. Вручную повторите неудачные или прерванные задачи. Часовой пояс: %1$@."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покушајте једном на дан када отворите или вратите се на Flare. Ручно поновите неуспеле или прекинуте задатке. Зона времена: %1$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök en gång per dag när du öppnar eller återvänder till Flare. Försök manuellt igen misslyckade eller avbrutna uppgifter. Tidszon: %1$@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flare'i açtığınızda veya geri döndüğünüzde her gün bir kez deneyin. Başarısız veya kesintiye uğrayan görevleri manuel olarak tekrar deneyin. Saat dilimi: %1$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте раз на день, коли відкриваєте або повертаєтеся до Flare. Вручну повторіть завдання, які не вдалося виконати або були перервані. Часовий пояс: %1$@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử mỗi ngày khi bạn mở hoặc quay lại Flare. Tự động thử lại các tác vụ thất bại hoặc bị gián đoạn. Múi giờ: %1$@."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天在開啟或返回 Flare 時嘗試執行一次。失敗或中斷的任務請手動重試。時區：%1$@。"
          }
        }
      }
    },
    "plugin_extension_revoke_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This plugin will no longer be able to use %1$@. Automatic tasks for this account will also be turned off."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此插件将无法再使用 %1$@，该账号的自动任务也会关闭。"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hierdie plugin sal nie meer in staat wees om %1$@ te gebruik nie. Outomatiese take vir hierdie rekening sal ook afgeskakel word."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتمكن هذا المكون الإضافي من استخدام %1$@ بعد الآن. سيتم أيضًا إيقاف المهام التلقائية لهذا الحساب."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Този плагин вече няма да може да използва %1$@. Автоматичните задачи за този акаунт също ще бъдат изключени."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest plugin ja no podrà utilitzar %1$@. Les tasques automàtiques per a aquest compte també es desactivarien."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento plugin již nebude schopen používat %1$@. Automatické úlohy pro tento účet budou také vypnuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne plugin vil ikke længere kunne bruge %1$@. Automatiske opgaver for denne konto vil også blive slået fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Plugin kann %1$@ danach nicht mehr verwenden. Automatische Aufgaben für dieses Konto werden ebenfalls deaktiviert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
