  "plugin_permission_http_origin": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Send requests and data to %1$@ while using the plugin"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "使用插件期间向 %1$@ 发送请求和数据"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Stuur versoeke en data na %1$@ terwyl jy die plugin gebruik"
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "أذونات الإضافات إرسال الطلبات والبيانات إلى %1$@ أثناء استخدام الإضافة"
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Изпращане на заявки и данни към %1$@ по време на използване на плагина"
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Enviar sol·licituds i dades a %1$@ mentre utilitzes el plugin"
