        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法儲存播放速度，請重試。"
          }
        },
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon nie afspeelspoed stoor nie. Probeer asseblief weer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر حفظ سرعة التشغيل. يرجى المحاولة مرة أخرى."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не успях да запазя скоростта на възпроизвеждане. Моля, опитайте отново."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha pogut guardar la velocitat de reproducció. Intenta de nou."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze uložit rychlost přehrávání. Zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gemme afspilningshastighed. Prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabegeschwindigkeit konnte nicht gespeichert werden. Bitte versuche es erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήταν δυνατή η αποθήκευση της ταχύτητας αναπαραγωγής. Δοκιμάστε ξανά."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toistoaikaa ei voitu tallentaa. Yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de sauvegarder la vitesse de lecture. Veuillez réessayer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשמור את מהירות ההשמעה. אנא נסה שוב."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült menteni a lejátszási sebességet. Kérjük, próbálja újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare la velocità di riproduzione. Riprova."
