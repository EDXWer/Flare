    "compose_save_draft_prompt" : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoor jou huidige inhoud as n konsep voordat jy sluit?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حفظ المحتوى الحالي كمسودة قبل الإغلاق؟"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Да се запази ли текущото съдържание като чернова преди затваряне?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols desar el contingut actual com a esborrany abans de tancar?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložit aktuální obsah před zavřením jako koncept?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du gemme dit nuværende indhold som en kladde, før du lukker?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuellen Inhalt vor dem Schließen als Entwurf speichern?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να αποθηκευτεί το τρέχον περιεχόμενο ως πρόχειρο πριν το κλείσιμο;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your current content as a draft before closing?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetaanko nykyinen sisältö luonnoksena ennen sulkemista?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrer le contenu actuel comme brouillon avant de fermer ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לשמור את התוכן הנוכחי כטיוטה לפני הסגירה?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mented az aktuális tartalmat piszkozatként bezárás előtt?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvare il contenuto corrente come bozza prima di chiudere?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閉じる前に現在の内容を下書きとして保存しますか？"
          }
        },
        "ko" : {
