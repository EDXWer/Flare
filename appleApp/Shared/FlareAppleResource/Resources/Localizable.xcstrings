  "plugin_unverified_github_warning": {
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This GitHub plugin has not been verified. Only install it if you trust the author."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此 GitHub 插件未经验证。请仅在信任作者时安装。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Hierdie GitHub plugin is nie geverifieer nie. Installeer dit slegs as jy die skrywer vertrou."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "لم يتم التحقق من إضافة GitHub هذه. قم بتثبيتها فقط إذا كنت تثق بالمؤلف."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Този GitHub плагин не е верифициран. Инсталирайте го само ако имате доверие в автора."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Aquest plugin GitHub no ha estat verificat. Només instal·leu-ho si confies en l'autor."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Tento plugin GitHub nebyl ověřen. Nainstalujte ho pouze tehdy, pokud důvěřujete autorovi."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Dette GitHub plugin er ikke verificeret. Installer det kun, hvis du stoler på forfatteren."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Dieses GitHub Plugin wurde nicht verifiziert. Installiere es nur, wenn du dem Autor vertraust."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Αυτό το plugin GitHub δεν έχει επαληθευτεί. Εγκαταστήστε το μόνο αν εμπιστεύεστε τον δημιουργό."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Tämä GitHub-plugin ei ole vahvistettu. Asenna se vain, jos luotat tekijään."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Ce plugin GitHub n'a pas été vérifié. Installez-le uniquement si vous faites confiance à l'auteur."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "תוסף GitHub זה לא אושר. התקן אותו רק אם אתה סומך על המחבר."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Ez az GitHub plugin nem ellenőrzött. Csak akkor telepítse, ha megbízik a szerzőben."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Questo plugin GitHub non è stato verificato. Installa solo se ti fidi dell'autore."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "このGitHubプラグインは未検証です。作成者を信頼する場合にのみインストールしてください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 GitHub 플러그인은 검증되지 않았습니다. 작성자를 신뢰하는 경우에만 설치하십시오."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Denne GitHub-pluginen er ikke verifisert. Installer den kun hvis du stoler på forfatteren."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Deze GitHub plugin is niet geverifieerd. Installeer deze alleen als u de auteur vertrouwt."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Ten plugin GitHub nie został zweryfikowany. Instaluj go tylko, jeśli ufasz autorowi."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Este plugin GitHub não foi verificado. Instale-o apenas se confiar no autor."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Este plugin GitHub não foi verificado. Instale apenas se você confiar no autor."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Acest plugin GitHub nu a fost verificat. Instalați-l doar dacă vă încred în autor."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Этот плагин GitHub не проверен. Устанавливайте, только если доверяете автору."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
