  "proxy_no_auth": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Supports TLS-encrypted HTTPS proxies and SOCKS5 with remote destination DNS. Plain HTTP proxies and proxy authentication are not supported."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "支持 TLS 加密的 HTTPS 代理和由代理解析目标域名的 SOCKS5。不支持明文 HTTP 代理及代理身份验证。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Ondersteun HTTPS-instaanbedieners wat met TLS geënkripteer is en SOCKS5-instaanbedieners wat DNS-navrae vir die bestemming op afstand hanteer. Ongeënkripteerde HTTP-instaanbedieners en verifikasie by die instaanbediener word nie ondersteun nie."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "يدعم التطبيق خوادم وكيلة من نوع HTTPS مشفّرة باستخدام TLS وخوادم SOCKS5 تحلّ أسماء الوجهات عبر DNS عن بُعد. لا يدعم خوادم HTTP غير المشفّرة أو المصادقة لدى الخادم الوكيل."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Поддържа TLS-шифрирани HTTPS проксита и SOCKS5 с отдалечен DNS на дестинацията. Прости HTTP проксита и автентикация на прокси не се поддържат."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Admet servidors intermediaris HTTPS xifrats amb TLS i servidors SOCKS5 amb resolució remota del DNS de la destinació. No admet servidors HTTP sense xifrar ni l’autenticació del servidor intermediari."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Podporuje TLS-šifrované HTTPS proxy a SOCKS5 s vzdáleným DNS cílem. Jednoduché HTTP proxy a autentizace proxy nejsou podporovány."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Understøtter TLS-krypterede HTTPS-proxies og SOCKS5 med fjern destinations-DNS. Almindelige HTTP-proxies og proxyautentificering understøttes ikke."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Unterstützt werden TLS-verschlüsselte HTTPS-Proxys und SOCKS5-Proxys, die Zieladressen per DNS auf dem Proxy auflösen. Unverschlüsselte HTTP-Proxys und Proxy-Authentifizierung werden nicht unterstützt."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Υποστηρίζονται διακομιστές μεσολάβησης HTTPS με κρυπτογράφηση TLS και διακομιστές SOCKS5 με απομακρυσμένη επίλυση DNS για τον προορισμό. Δεν υποστηρίζονται μη κρυπτογραφημένοι διακομιστές HTTP ή έλεγχος ταυτότητας στον διακομιστή μεσολάβησης."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Tukee TLS-salaatun HTTPS-välityspalvelimen ja SOCKS5:n etäkohtaisen määränpää-DNS:n kanssa. Pelkät HTTP-välityspalvelimet ja välityspalvelimen todennus eivät ole tuetut."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Les proxys HTTPS chiffrés par TLS et les proxys SOCKS5 avec résolution DNS distante sont pris en charge. Les proxys HTTP non chiffrés et l’authentification auprès d’un proxy ne sont pas pris en charge."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "תומך ב-HTTPS פרוקסי מוצפנים ב-TLS וב-SOCKS5 עם DNS יעד מרוחק. פרוקסי HTTP רגילים והתחברות פרוקסי אינם נתמכים."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Támogatja a TLS-rögzített HTTPS proxy-kat és SOCKS5-et távoli cél DNS-szel. A plain HTTP proxy-kat és a proxy hitelesítést nem támogatja."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Supporta proxy HTTPS crittografati con TLS e SOCKS5 con DNS di destinazione remoto. I proxy HTTP in chiaro e l'autenticazione del proxy non sono supportati."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "TLS で暗号化された HTTPS プロキシと、接続先の名前解決をプロキシ側で行う SOCKS5 に対応しています。暗号化されていない HTTP プロキシとプロキシ認証には対応していません。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "TLS로 암호화된 HTTPS 프록시 및 원격 대상 DNS를 사용하는 SOCKS5를 지원합니다. 일반 HTTP 프록시 및 프록시 인증은 지원되지 않습니다."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Støtter TLS-krypterte HTTPS- og SOCKS5-proxier med fjern destinasjons-DNS. Enkle HTTP-proxier og proxyautentisering støttes ikke."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Ondersteunt TLS-versleutelde HTTPS proxies en SOCKS5 met externe bestemming DNS. Gewone HTTP proxies en proxy-authenticatie worden niet ondersteund."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Obsługiwane są serwery proxy HTTPS szyfrowane protokołem TLS oraz serwery SOCKS5 ze zdalnym rozpoznawaniem nazw DNS. Nieszyfrowane serwery proxy HTTP oraz uwierzytelnianie na serwerze proxy nie są obsługiwane."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Suporta proxies HTTPS encriptados com TLS e proxies SOCKS5 com resolução remota de DNS para o destino. Não suporta proxies HTTP sem encriptação nem autenticação no proxy."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Compatível com proxies HTTPS criptografados com TLS e proxies SOCKS5 com resolução remota de DNS para o destino. Proxies HTTP sem criptografia e autenticação no proxy não são compatíveis."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Suportă proxy-uri HTTPS criptate TLS și SOCKS5 cu DNS de destinație remot. Proxy-urile HTTP simple și autentificarea proxy-ului nu sunt suportate."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Поддерживает прокси HTTPS с шифрованием TLS и SOCKS5 с удаленным DNS назначения. Простые прокси HTTP и аутентификация прокси не поддерживаются."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Подржани су HTTPS проксији шифровани TLS-ом и SOCKS5 проксији који удаљено разрешавају DNS одредишта. Нешифровани HTTP проксији и пријављивање на прокси нису подржани."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Stöder TLS-krypterade HTTPS-proxys och SOCKS5 med fjärrdestination DNS. Rena HTTP-proxys och proxyautentisering stöds inte."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "TLS şifreli HTTPS ve uzaktan hedef DNS'li SOCKS5 proxy'lerini destekler. Düz HTTP proxy'leri ve proxy kimlik doğrulaması desteklenmemektedir."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Підтримує проксі HTTPS із шифруванням TLS та SOCKS5 з віддаленим DNS призначення. Прості проксі HTTP та автентифікація проксі не підтримуються."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Hỗ trợ proxy HTTPS được mã hóa TLS và SOCKS5 với DNS đích từ xa. Không hỗ trợ proxy HTTP thuần túy và xác thực proxy."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "支援使用 TLS 加密的 HTTPS 代理伺服器，以及在遠端解析目的地 DNS 的 SOCKS5 代理伺服器。不支援未加密的 HTTP 代理伺服器或代理伺服器驗證。"
        }
      }
    }
  },
