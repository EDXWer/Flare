  "proxy_in_use": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Reassign global and account settings before deleting this proxy."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "删除前请先调整使用此代理的全局和账号设置。"
        }
      },
      "af": {
        "stringUnit": {
          "state": "translated",
          "value": "Hertoewis globale en rekeninginstellings voordat hierdie proxy verwyder word."
        }
      },
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "أعد تعيين الإعدادات العامة والحساب قبل حذف هذا الوكيل."
        }
      },
      "bg": {
        "stringUnit": {
          "state": "translated",
          "value": "Пренасочете глобалните и сметковите настройки преди изтриването на този прокси."
        }
      },
      "ca": {
        "stringUnit": {
          "state": "translated",
          "value": "Reassignar configuracions globals i de compte abans de suprimir aquest proxy."
        }
      },
      "cs": {
        "stringUnit": {
          "state": "translated",
          "value": "Připřiřačte globální a účetní nastavení před smazáním tohoto proxy."
        }
      },
      "da": {
        "stringUnit": {
          "state": "translated",
          "value": "Tildel globale og kontiindstillinger, før du sletter denne proxy."
        }
      },
      "de": {
        "stringUnit": {
          "state": "translated",
          "value": "Weise globale und Kontoeinstellungen neu zu, bevor du diesen Proxy löschst."
        }
      },
      "el": {
        "stringUnit": {
          "state": "translated",
          "value": "Αλλάξτε τις καθολικές ρυθμίσεις και τις ρυθμίσεις των λογαριασμών πριν διαγράψετε αυτόν τον διακομιστή."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "translated",
          "value": "Määritä uudelleen globaalit ja tilikohtaiset asetukset ennen tämän proxyn poistamista."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Réattribuer les paramètres globaux et par compte avant de supprimer ce proxy."
        }
      },
      "he": {
        "stringUnit": {
          "state": "translated",
          "value": "הקצה מחדש הגדרות גלובליות וחשבון לפני מחיקת פרוקסי זה."
        }
      },
      "hu": {
        "stringUnit": {
          "state": "translated",
          "value": "Hozzárendelje a globális és számlako-beállításokat, mielőtt törli ezt a proxyt."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Riassegna le impostazioni globali e di account prima di eliminare questo proxy."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "このプロキシを削除する前に、グローバルおよびアカウント設定を再割り当てしてください。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "이 프록시를 삭제하기 전에 전역 및 계정 설정을 재할당하십시오."
        }
      },
      "nb": {
        "stringUnit": {
          "state": "translated",
          "value": "Tildel globale og kontoinnstillinger før du sletter denne proxyen."
        }
      },
      "nl": {
        "stringUnit": {
          "state": "translated",
          "value": "Wijs globale en accountinstellingen toe voordat u deze proxy verwijdert."
        }
      },
      "pl": {
        "stringUnit": {
          "state": "translated",
          "value": "Przypisz globalne i ustawienia konta przed usunięciem tego proxy."
        }
      },
      "pt": {
        "stringUnit": {
          "state": "translated",
          "value": "Reatribuir definições globais e de conta antes de eliminar este proxy."
        }
      },
      "pt-BR": {
        "stringUnit": {
          "state": "translated",
          "value": "Reatribua as configurações global e de conta antes de excluir este proxy."
        }
      },
      "ro": {
        "stringUnit": {
          "state": "translated",
          "value": "Reatribuie setările globale și ale contului înainte de a șterge acest proxy."
        }
      },
      "ru": {
        "stringUnit": {
          "state": "translated",
          "value": "Переназначьте глобальные и аккаунтные настройки перед удалением этого прокси."
        }
      },
      "sr": {
        "stringUnit": {
          "state": "translated",
          "value": "Поново доделите глобална и рачунска подешавања пре брисања овог проксија."
        }
      },
      "sv": {
        "stringUnit": {
          "state": "translated",
          "value": "Tilldela om globala och kontoinställningar innan du tar bort denna proxy."
        }
      },
      "tr": {
        "stringUnit": {
          "state": "translated",
          "value": "Bu proxy'yi silmeden önce global ve hesap ayarlarını yeniden atayın."
        }
      },
      "uk": {
        "stringUnit": {
          "state": "translated",
          "value": "Перепризначте глобальні та облікові налаштування перед видаленням цього проксі."
        }
      },
      "vi": {
        "stringUnit": {
          "state": "translated",
          "value": "Gán lại cài đặt toàn cầu và tài khoản trước khi xóa proxy này."
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "刪除此代理前，請重新指派全域和帳號設定。"
        }
      }
    }
