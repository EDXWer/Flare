  "proxy_error_request": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Proxy operation failed. Please try again."}}, "zh-Hans": {"stringUnit": {"state": "translated", "value": "代理操作失败，请重试。"}},
