    {
      "name": "API v2 is supported",
      "patch": {
        "apiVersion": 2
      },
      "schemaValid": true,
      "hostValid": true
    },
    {
      "name": "additional HTTP origins",
      "patch": {
        "permissions": {
          "authOrigins": [
            "https://api.example.org"
          ],
          "httpOrigins": [
            "https://api.example.org",
            "https://cdn.example.org:8443"
          ]
