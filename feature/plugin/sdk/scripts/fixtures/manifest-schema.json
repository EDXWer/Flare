          ]
        }
      },
      "schemaValid": false,
      "hostValid": false
    },
    {
      "name": "HTTP origin does not grant Cookie probes",
      "patch": {
        "permissions": {
          "httpOrigins": [
            "https://api.example.org"
          ]
        },
        "platform": {
          "loginMethods": [
            {
              "id": "cookie",
              "interaction": "WebCookie",
              "title": "Cookie",
              "cookie": {
                "startUrl": "https://api.example.org/login",
                "probes": [
                  {
                    "url": "https://api.example.org/me",
                    "cookies": [
                      {
                        "name": "session",
                        "required": true
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "schemaValid": true,
      "hostValid": false
    },
    {
      "name": "HTTP origin does not grant deep links",
      "patch": {
        "permissions": {
          "httpOrigins": [
            "https://api.example.org"
          ]
        },
        "platform": {
          "deepLinks": [
            {
              "origin": "https://api.example.org",
              "path": [
                {
                  "type": "literal",
                  "value": "profile"
                },
                {
                  "type": "capture",
                  "name": "handle"
                }
              ],
              "target": {
                "type": "Profile",
                "value": "{handle}"
              }
            }
          ]
        }
      },
      "schemaValid": true,
      "hostValid": false
    },
